+ * VendorTable is the producer's immutable 1376-byte hph_record BEFORE EBS.
+ * This GUID does not authorize live GPU resources or any post-EBS pointer.
+ */
+#ifndef HOUJI_GPU_POWER_HANDOFF_GUID_H
+#define HOUJI_GPU_POWER_HANDOFF_GUID_H
+#define HOUJI_GPU_POWER_HANDOFF_GUID \
+ {0x02bec0e7,0xe434,0x48c6,{0xba,0x89,0x3b,0x35,0xb5,0xb6,0x1e,0x47}}
