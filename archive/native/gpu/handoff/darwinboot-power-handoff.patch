+    if(!gpp_read_value(io,r,GPP_REG_GMU))return r->code;
+    r->expected=0;r->mask=1;r->flags|=GPP_EXPECTED_VALID|GPP_MASK_VALID;
+    if(r->values[GPP_REG_GMU]&1) {
+        r->operation=GPP_OP_VALIDATE;return gpp_fail(r,GPP_ERR_INITIAL,0);
+    }
