+    /// Native port SPI: an ASTC 4x4 2D sampled image over the explicit block-row
+    /// layout returned by this port's MTLTextureLayout. This does not relax the
+    /// public Metal buffer-texture rules and never interprets Apple's tiled data.
+    /// Normal shadow tracking retains the source and observes later CPU writes.
+    pub fn new_native_raw_astc4x4_texture(
+        &self, descriptor: &TextureDescriptor, bytes_per_row: u64,
+    ) -> Result<Texture, Error> {
+        const CALL: &str = "new_native_raw_astc4x4_texture";
+        let fail = || Error::NotImplemented(RuntimeGap::Textures);
+        if !matches!(descriptor.pixel_format, PixelFormat::ASTC4x4LDR | PixelFormat::ASTC4x4SRGB)
+            || descriptor.texture_type != TextureType::Type2D || descriptor.depth != 1
+            || descriptor.array_length != 1 || descriptor.mipmap_level_count != 1
+            || descriptor.sample_count != 1 || descriptor.rotation != 0
+            || descriptor.framebuffer_only || self.detached()
+            || !(TextureUsage::SHADER_READ | TextureUsage::PIXEL_FORMAT_VIEW).contains(descriptor.usage)
+            || descriptor.width == 0 || descriptor.height == 0
+        { return Err(fail()); }
+        let device = self.device();
+        let descriptor = TextureDescriptor {
+            resource_options: self.resource_options(), ..device.take_texture_options(CALL, descriptor)
+        };
+        let layout = descriptor.check_made(Creator::Device, device.properties().texture_rules())
+            .map_err(|refused| refused.error(CALL))?;
+        let [width, height, _] = layout.extent;
+        let row_bytes = u64::from(width).div_ceil(4).checked_mul(16).ok_or_else(fail)?;
+        let rows = u64::from(height).div_ceil(4);
+        let slice = bytes_per_row.checked_mul(rows).ok_or_else(fail)?;
+        if bytes_per_row < row_bytes || bytes_per_row % 16 != 0 || slice > self.length() {
+            return Err(fail());
+        }
+        let placed = BufferLayout {offset: 0, row_pitch: bytes_per_row,
+            slice_pitch: slice, row_bytes, rows, slices: 1};
+        let mut texels = Texels::new(self.clone(), placed, 16, &descriptor);
+        texels.block_extent = [4, 4]; texels.image_extent = Some([width, height]);
+        device.new_texture_over_buffer(CALL, texels, &descriptor, &layout,
+            IdUse::Program(descriptor.placement))
     }
 
