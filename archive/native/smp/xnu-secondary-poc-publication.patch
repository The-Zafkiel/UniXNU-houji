 #if defined(SWEET)
+/*
+ * PSCI CPU_ON starts a secondary with caches off. Its reset assembly reads
+ * these CPU0-populated objects before enabling the MMU. DSB orders stores but
+ * does not publish dirty cache lines to PoC. Keep their real types in osfmk.
+ * Snapshot first; this helper neither writes control registers nor prints.
+ */
+uint32_t
+houji_publish_secondary_state(uint64_t *tcr, uint64_t *root)
+{
+    const uint64_t published_tcr = sysreg_restore.tcr_el1;
+    const uint64_t published_root = cpu_ttep;
+    flush_dcache((vm_offset_t)&sysreg_restore, sizeof(sysreg_restore), FALSE);
+    flush_dcache((vm_offset_t)&cpu_ttep, sizeof(cpu_ttep), FALSE);
+    if (tcr) { *tcr = published_tcr; }
+    if (root) { *root = published_root; }
+    return (uint32_t)(sizeof(sysreg_restore) + sizeof(cpu_ttep));
+}
