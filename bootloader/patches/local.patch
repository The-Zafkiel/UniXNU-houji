+STATIC EFI_STATUS VerifyHighWindow (EFI_PHYSICAL_ADDRESS Address, UINT64 Bytes) {
+  EFI_PHYSICAL_ADDRESS Ordinary = 0;
+  VOID *Pool = AllocatePool (SIZE_4KB);
+  EFI_STATUS Status = gBS->AllocatePages (AllocateAnyPages, EfiLoaderData, 4, &Ordinary);
