+                Ordinary <= 0xFFFFFFFFULL - SIZE_16KB;
+  if (Pool != NULL) { FreePool (Pool); }
+  if (!EFI_ERROR (Status)) { gBS->FreePages (Ordinary, 4); }
+  if (!Low || (Bytes != SIZE_2GB && Bytes != SIZE_8GB) || Address < 0x8C0000000ULL ||
+      Address > 0xBEA400000ULL - Bytes) { return EFI_UNSUPPORTED; }
+  Print (L"HOUJI MEMORY: automatic page/pool allocations below 4 GiB PASS\n");
+  Print (L"HOUJI MEMORY: testing owned %lu GiB at %lx, two full patterns\n", Bytes >> 30, Address);
+  if (!DarwinTestOwnedMemory ((volatile unsigned long long *)(UINTN)Address,
+                             Bytes / sizeof (UINT64), FlushOwnedMemory)) {
+    Print (L"HOUJI MEMORY: full-window verification FAILED\n");
+    return EFI_DEVICE_ERROR;
+  }
+  Print (L"HOUJI MEMORY: full %lu GiB write/flush/read PASS\n", Bytes >> 30);
+  return EFI_SUCCESS;
+}
+#endif
