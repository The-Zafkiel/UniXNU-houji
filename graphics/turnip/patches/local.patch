+/* The GPU address of the pass timestamp slot of seq (two 64-bit words), its words cleared; 0 when cmd's device has no buffer (only
+ * the first device that records a pass gets one).
+ */
+static uint64_t
+tu_pass_ts_slot(struct tu_cmd_buffer *cmd, uint32_t seq)
+{
+   struct tu_device *dev = cmd->device;
+   if (!p_atomic_read(&tu_pass_ts_bo)) {
+      simple_mtx_lock(&tu_pass_ts_lock);
+      if (!tu_pass_ts_bo && !tu_pass_ts_dev) {
+         tu_pass_ts_dev = dev;
+         struct tu_bo *bo = NULL;
+         if (tu_bo_init_new(dev, NULL, &bo, 512 * 16, TU_BO_ALLOC_INTERNAL_RESOURCE, "pass timestamps") == VK_SUCCESS) {
+            if (tu_bo_map(dev, bo, NULL) == VK_SUCCESS) {
+               memset(bo->map, 0, 512 * 16);
+               p_atomic_set(&tu_pass_ts_bo, bo);
+            } else {
