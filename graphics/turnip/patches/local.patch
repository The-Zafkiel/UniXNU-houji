+   int8_t fs_waves, fs_regs;                            /* its max waves per core and highest GPR */
+   uint8_t samples;                                     /* sample count of the first colour attachment */
+   uint8_t ds;                                          /* 1 depth/stencil attachment, 2 the pass has a resolve */
+   uint32_t bandwidth;                                  /* the draws' estimated bandwidth per sample (bytes), the autotuner's figure */
