+static uint32_t tu_pass_seq;
+static struct tu_device *tu_pass_ts_dev;
+static struct tu_bo *tu_pass_ts_bo;
+static simple_mtx_t tu_pass_ts_lock = SIMPLE_MTX_INITIALIZER;
