+/* Tile memory holds a colour as the shader wrote it, whatever swap its image has in memory, so a load or store reads and writes
+ * it with the identity swap. Per site (tu_gmem_side_stats): [0] transfers, [1] of them with a swap other than WZYX on the tile
+ * side, [2] with MUTABLEEN, [3] of a linear image in memory. [1] is the counter that must stay zero for linear images.
+ */
+static uint64_t tu_gmem_side_counts[4][4];
+
+void
+tu_note_gmem_side(struct tu_cmd_buffer *cmd, const struct tu_image_view *iview, unsigned site, bool linear, bool mutableen, unsigned swap)
+{
+   tu_frame_event(37,(uintptr_t)cmd,site,(uintptr_t)iview,(uintptr_t)iview->image,iview->vk.format,linear,mutableen,swap,iview->view.color_swap,iview->view.is_mutable);
+   p_atomic_inc(&tu_gmem_side_counts[site][0]);
+   if (swap != WZYX)
+      p_atomic_inc(&tu_gmem_side_counts[site][1]);
+   if (mutableen)
+      p_atomic_inc(&tu_gmem_side_counts[site][2]);
+   if (linear)
+      p_atomic_inc(&tu_gmem_side_counts[site][3]);
+}
+
+extern "C" __attribute__((visibility("default"))) void tu_gmem_side_stats(uint64_t out[16]);
+extern "C" __attribute__((visibility("default"))) void
+tu_gmem_side_stats(uint64_t out[16])
+{
+   for (unsigned i = 0; i < 16; i++)
+      out[i] = p_atomic_read(&tu_gmem_side_counts[i / 4][i % 4]);
+}
